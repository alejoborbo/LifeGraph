# Path to your Google OAuth2 credentials file (downloaded from GCP Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be stored after first auth
GOOGLE_TOKEN_PATH=token.json

# SQLite database path
DATABASE_PATH=lifegraph.db

# Anthropic API key for topic extraction
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Confluence (optional - for syncing Confluence pages)
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=you@company.com
CONFLUENCE_API_TOKEN=your-api-token
# Optional: limit to a specific space
CONFLUENCE_SPACE_KEY=
