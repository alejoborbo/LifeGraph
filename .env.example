# Your display name (used to filter "my docs" vs "other people's docs")
LIFEGRAPH_AUTHOR=Your Name

# Path to your Google OAuth2 credentials file (downloaded from GCP Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be stored after first auth
GOOGLE_TOKEN_PATH=token.json

# SQLite database path
DATABASE_PATH=lifegraph.db

# Anthropic API key for topic extraction
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Confluence (optional - for syncing Confluence pages)
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=you@company.com
CONFLUENCE_API_TOKEN=your-api-token
# Optional: limit to a specific space
CONFLUENCE_SPACE_KEY=

# Slack (optional - for syncing threads as documents)
SLACK_TOKEN=xoxb-...
# Comma-separated channel names to sync (empty = all joined channels)
SLACK_CHANNELS=monitoring-posture,team-alerts
# Your workspace URL (for generating permalinks)
SLACK_WORKSPACE_URL=https://datadog.slack.com

# GitHub (optional - for syncing PRs and issues)
GITHUB_TOKEN=ghp_...
# Comma-separated list of repos to sync
GITHUB_REPOS=owner/repo1,owner/repo2
# JSON mapping of repo to project name
GITHUB_REPO_PROJECT_MAP={"owner/repo1": "My Project Name"}
